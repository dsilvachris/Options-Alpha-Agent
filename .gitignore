# Secrets — never commit
.env
.env.local
*.env
!.env.example

# MCP config files that can hold credentials
mcp.json
.mcp.json
mcp_config.json
claude_desktop_config.json
**/mcp*.json
!**/mcp_schema.json

# Environments
.venv/
venv/
env/

# Data & logs — the SQLite store never ships
data/
logs/

# The published dashboard snapshot IS committed (Vercel serves it).
# Re-included explicitly because it lives under a directory name that would
# otherwise be caught by the data/ rule above.
!dashboard/public/
!dashboard/public/**

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS / editor
.DS_Store
.idea/
.vscode/
